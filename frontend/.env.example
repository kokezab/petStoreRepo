# Petstore demo backend. Tracer (the real backend) is configured separately below.
VITE_API_BASE_URL=https://petstore.swagger.io/v2
# Tracer backend (separate service from the petstore demo). Its generated SDK
# paths look like `/v1/equipment`, served from this base.
VITE_TRACER_API_BASE_URL=http://localhost:8080/api

VITE_UNLEASH_URL=http://localhost:4242/api/frontend
VITE_UNLEASH_CLIENT_KEY=
VITE_UNLEASH_APP_NAME=frontend

# Deployed (Vercel) values point at the hosted getunleash.io instance instead of
# localhost, and use a Frontend API token scoped to the matching Unleash
# environment. These are set as Environment Variables in Vercel project settings
# (scoped per Vercel environment below), never committed here:
#
#   Vercel "Preview"    -> VITE_UNLEASH_URL=https://<your-instance>.getunleash.io/api/frontend
#                          VITE_UNLEASH_CLIENT_KEY=<frontend token for the "development" Unleash env>
#   Vercel "Production" -> VITE_UNLEASH_URL=https://<your-instance>.getunleash.io/api/frontend
#                          VITE_UNLEASH_CLIENT_KEY=<frontend token for the "production" Unleash env>
#
# See the root README's "Deployed environments (Vercel)" section for full steps.

# VITE_I18N_LOAD_PATH controls where translation JSON is fetched from.
# {{lng}} is replaced with the active language code (e.g. "en", "sr").
#
#   Static files (default): VITE_I18N_LOAD_PATH=/locales/{{lng}}/translation.json
#   Backend API:             VITE_I18N_LOAD_PATH=https://petstore.swagger.io/v2/translations/{{lng}}
#                            (Vite does not expand other env vars here, so write
#                            the full URL rather than referencing VITE_API_BASE_URL)
VITE_I18N_LOAD_PATH=/locales/{{lng}}/translation.json

# Sentry (observability). Leave VITE_SENTRY_DSN empty to disable entirely -
# Sentry.init no-ops without a DSN, which is what local dev should do.
#   Vercel "Preview"    -> VITE_SENTRY_ENVIRONMENT=staging
#   Vercel "Production" -> VITE_SENTRY_ENVIRONMENT=production
# Source-map upload (@sentry/vite-plugin) is a separate, build-time-only
# concern controlled by SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN -
# set those as CI secrets, never in this file or committed anywhere.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
